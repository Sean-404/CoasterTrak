{
  "name": "coastertrak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "wikidata:inspect-park": "tsx scripts/inspect-wikidata-park.ts",
    "wikipedia:backfill": "tsx --env-file=.env.local scripts/wikipedia-infobox-backfill.ts",
    "wikipedia:backfill-images": "tsx --env-file=.env.local scripts/backfill-wikipedia-images.ts",
    "wikipedia:backfill-summaries": "tsx --env-file=.env.local scripts/backfill-wikipedia-summaries.ts",
    "status:normalize": "tsx scripts/normalize-coaster-statuses.ts",
    "data:match-themeparks": "tsx --env-file=.env.local scripts/match-themeparks-wiki.ts",
    "data:ingest-wikidata": "tsx scripts/data/ingest-wikidata.ts",
    "data:normalize-wikidata": "tsx scripts/data/normalize-wikidata.ts",
    "data:materialize-snapshot": "tsx scripts/data/materialize-snapshot.ts",
    "data:enrich-wikipedia": "tsx scripts/data/enrich-wikipedia.ts",
    "data:validate-wikidata": "tsx scripts/data/validate-wikidata.ts",
    "data:analyze-catalog": "tsx scripts/data/analyze-catalog.ts",
    "data:publish-catalog": "tsx scripts/data/publish-catalog.ts",
    "data:relink-placeholder-parks": "tsx --env-file=.env.local scripts/relink-placeholder-parks.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bad-words": "^4.0.0",
    "cheerio": "^1.2.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "next": "^16.2.12",
    "react": "^19.2.5",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "^8.0.1",
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.0",
    "minimatch": "^10.2.6",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "undici": "^7.28.0",
    "ws": "^8.21.1"
  }
}
